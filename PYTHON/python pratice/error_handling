#using class we handling exception
class ValueTooSmallError(Exception):
    # pass
    def __init__(self):
        self.message = "The value is too small!"

class ValueTooBigError(Exception):
    # pass
    def __init__(self):
        self.message = "The value is too big!"


number_to_guess = 10

try:
    user_guess = int(input("Guess the number: "))
    if user_guess < number_to_guess:
        raise ValueTooSmallError#("The value is too small!")
    elif user_guess > number_to_guess:
        raise ValueTooBigError#("The value is too big!")
    else:
        print("Congratulations! You guessed the right number.")
except ValueTooSmallError as e:
    # print(e)
    print(e.message)
except ValueTooBigError as e:
    # print(e)
    print(e.message)
except ValueError:
    print("Invalid input: Please enter an integer.")
